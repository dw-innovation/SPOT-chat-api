LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-endpoint.example.org/v1
LLM_MODEL=GPT-oss-120b
# LLM_MODELS=GPT-oss-120b,another-model
# LLM_TEMPERATURE=0
# LLM_REASONING_EFFORT=low
# API server (api.py), see "Going public" in API.md:
# SPOT_API_KEY=choose-a-secret
# SPOT_CORS_ORIGINS=https://your-frontend.example.org
# SPOT_RATE_LIMIT=30
# SPOT_DEBUG=1
# Local Ollama instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
