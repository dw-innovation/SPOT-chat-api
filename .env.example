# Copy to .env and fill in. Variables already set in the shell take precedence.

# --- Language model (OpenAI-compatible endpoint) ---
# Required
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.example.com/v1
# e.g. http://localhost:11434/v1 for Ollama

# Model name (default GPT-oss-120b)
LLM_MODEL=GPT-oss-120b
# Optional comma-separated list; adds a model picker to the demo UI and is what the API accepts as `model`
LLM_MODELS=
# Optional; 0 recommended for reproducible benchmarks
LLM_TEMPERATURE=
# Optional; low / medium / high for reasoning models
LLM_REASONING_EFFORT=
# Tool-call rounds per message (default 8)
LLM_MAX_TOOL_ROUNDS=8
# Request timeout in seconds (default 120)
LLM_TIMEOUT=120
# Limit in seconds for a whole chat turn, all tool rounds together; empty = off.
# 50 behind the SPOT frontend, whose route ends after 60 seconds.
LLM_TURN_TIMEOUT=
# 1 asks a LiteLLM proxy for fresh answers instead of cached ones (test runs); other servers may reject it
LLM_NO_CACHE=

# --- SPOT tables & services ---
# Tag search endpoint; set to empty to disable
SPOT_TAG_SEARCH_URL=https://tags.findthatspot.io/api/search
SPOT_TAG_SEARCH_TIMEOUT=4
# Defaults point to the files in data/
# SPOT_BUNDLES_PATH=data/SPOT_OSM-tag-bundles.xlsx
# SPOT_COLOURS_PATH=data/spot_colours.csv
# Query size SPOT is trained for (default 3 each)
SPOT_MAX_ENTITIES=3
SPOT_MAX_PROPERTIES=3
# 1 also writes the spatial term ("next to") into the YAML; by default only its distance
SPOT_INCLUDE_SPATIAL_TERM=0

# --- API server (see "Going public" in API.md) ---
# If set, every request needs the header X-API-Key: <value>; empty means open
SPOT_API_KEY=
# Comma-separated origins for browser calls (default *).
# Note: docker-compose.yml sets this under `environment:`, which overrides the value here.
SPOT_CORS_ORIGINS=*
# /chat calls per minute and client (default 30, 0 = off)
SPOT_RATE_LIMIT=30
# 1 enables /docs, fills tool_calls and makes /health detailed; leave empty on a public server
SPOT_DEBUG=
